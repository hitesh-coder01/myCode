  const fetchCart = () => {
    if (!token) return
    axios.get(`${BASE_URL}/api/cart/`, getAuthConfig())
      .then(res => {
        setCartItems(res.data.items || [])
        setCartTotal(res.data.total_amount || 0)
        setCartCount(res.data.total_items_count || 0)
      })
      .catch(err => {
        if (err.response?.status === 401) handleLogout()
