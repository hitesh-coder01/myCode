            {/* Cart Items Scrollable List */}
            <div className="p-5 flex-1 overflow-y-auto space-y-4">
              {!token ? (
                <div className="text-center py-16">
                  <span className="text-4xl block mb-2">🔒</span>
                  <p className="text-sm font-semibold text-slate-700">Aap logged in nahi hain</p>
                  <p className="text-xs text-slate-500 mt-1">Apna cart dekhne ke liye please login karein.</p>
