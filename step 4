import { useEffect, useState } from 'react'
import axios from 'axios'

function App() {
  const [tasks, setTasks] = useState([])
  const [loading, setLoading] = useState(true)
  
  const [newTitle, setNewTitle] = useState('')
  const [newDesc, setNewDesc] = useState('')

  // 1. READ: Saare tasks fetch karna
  const fetchTasks = () => {
    axios.get('http://127.0.0.1:8000/')
      .then(response => {
        setTasks(response.data)
        setLoading(false)
      })
      .catch(error => {
        console.error("Error fetching tasks:", error)
        setLoading(false)
      })
  }

  useEffect(() => {
    fetchTasks()
  }, [])

  // 2. CREATE: Naya task add karna (POST)
  const handleAddTask = (e) => {
    e.preventDefault()
    if (!newTitle.trim()) return

    axios.post('http://127.0.0.1:8000/', {
      title: newTitle,
      description: newDesc,
      completed: false
    })
    .then(response => {
      setTasks([...tasks, response.data])
      setNewTitle('')
      setNewDesc('')
    })
    .catch(error => {
      console.error("Error creating task:", error)
    })
  }

  // 3. DELETE: Task delete karna (DELETE)
  const handleDeleteTask = (id) => {
    axios.delete(`http://127.0.0.1:8000/delete/${id}/`)
      .then(() => {
        setTasks(tasks.filter(task => task.id !== id))
      })
      .catch(error => {
        console.error("Error deleting task:", error)
      })
  }

  // 4. UPDATE: Task ka status toggle karna (PATCH)
  const handleToggleComplete = (task) => {
    // Current status ka ulta status bhejna
    const updatedStatus = !task.completed

    axios.patch(`http://127.0.0.1:8000/update/${task.id}/`, {
      completed: updatedStatus
    })
    .then(response => {
      // Sirf us task ka status state me update karein
      setTasks(tasks.map(t => t.id === task.id ? response.data : t))
    })
    .catch(error => {
      console.error("Error updating task:", error)
    })
  }

  return (
    <div className="min-h-screen bg-slate-100 py-10 px-4 font-sans">
      <div className="max-w-2xl mx-auto">
        <header className="text-center mb-8">
          <h1 className="text-3xl font-extrabold text-slate-800 tracking-tight">
            Django + React Full Stack
          </h1>
          <p className="text-slate-500 mt-2 text-sm font-medium">
            Step 4: Full CRUD Completed (Create, Read, Update, Delete)
          </p>
        </header>

        {/* Input Form Card */}
        <form onSubmit={handleAddTask} className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-8 space-y-4">
          <h2 className="text-lg font-bold text-slate-800">Add New Item</h2>
          <div>
            <input 
              type="text" 
              placeholder="Task Title (e.g. Django Auth Setup)"
              value={newTitle}
              onChange={(e) => setNewTitle(e.target.value)}
              className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              required
            />
          </div>
          <div>
            <input 
              type="text" 
              placeholder="Description (Optional)"
              value={newDesc}
              onChange={(e) => setNewDesc(e.target.value)}
              className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
            />
          </div>
          <button 
            type="submit" 
            className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm shadow-sm"
          >
            Add Task
          </button>
        </form>

        {/* Items List */}
        <h2 className="text-xl font-bold text-slate-800 mb-4">Your Tasks</h2>

        {loading ? (
          <div className="flex justify-center items-center py-12">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
            <span className="ml-3 text-slate-600 font-medium">Loading items...</span>
          </div>
        ) : tasks.length === 0 ? (
          <div className="bg-white p-6 rounded-xl shadow-sm text-center text-slate-500 border border-slate-200">
            Koi task nahi hai! Upar form se naya add karein.
          </div>
        ) : (
          <div className="space-y-4">
            {tasks.map(task => (
              <div 
                key={task.id} 
                className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex justify-between items-center transition-all hover:shadow-md"
              >
                <div>
                  <h3 className={`text-lg font-bold mb-1 transition-all ${
                    task.completed ? 'line-through text-slate-400' : 'text-slate-800'
                  }`}>
                    {task.title}
                  </h3>
                  <p className={`text-sm ${
                    task.completed ? 'text-slate-400' : 'text-slate-600'
                  }`}>
                    {task.description || "No description provided."}
                  </p>
                </div>
                
                <div className="flex items-center gap-3">
                  {/* Status Toggle Button */}
                  <button 
                    onClick={() => handleToggleComplete(task)}
                    title="Click to toggle status"
                    className={`text-xs font-semibold px-3 py-1.5 rounded-full cursor-pointer transition-all border ${
                      task.completed 
                        ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' 
                        : 'bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100'
                    }`}
                  >
                    {task.completed ? '✓ Completed' : '⏳ Pending'}
                  </button>

                  {/* Delete Button */}
                  <button 
                    onClick={() => handleDeleteTask(task.id)}
                    className="text-xs bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold px-3 py-1.5 rounded-lg border border-rose-200 transition-colors"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

export default App

