frontend/src/App.jsx file kholein, uska sara code hata dein aur yeh chhota code paste karein:
import { useEffect, useState } from 'react'
import axios from 'axios'

function App() {
  const [data, setData] = useState(null)

  useEffect(() => {
    // Django API ko call kar rahe hain
    axios.get('http://127.0.0.1:8000/')
      .then(response => {
        setData(response.data)
      })
      .catch(error => {
        console.error("API error:", error)
      })
  }, [])

  return (
    <div style={{ textAlign: 'center', marginTop: '50px', fontFamily: 'Arial' }}>
      <h1>React + Django DRF (Step 1 Complete)</h1>
      {data ? (
        <div style={{ border: '2px solid green', padding: '20px', display: 'inline-block' }}>
          <h3>Backend se aaya hua data:</h3>
          <p>{data.message}</p>
          <p>Status: <strong>{data.status}</strong></p>
        </div>
      ) : (
        <p>Loading backend data...</p>
      )}
    </div>
  )
}

export default App

